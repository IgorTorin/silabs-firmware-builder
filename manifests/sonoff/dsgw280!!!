metadata:
  name: dsgw280
  description: "OpenThread RCP 4.3.1 for Dusun DSGW-280 (EFR32MG21)"

sdk:
  version: 4.3.1

device:
  part: efr32mg21a010f768im32

configuration:
  components:
    - id: ot_rcp
    - id: uart_multiplex
    - id: cpc_core
    - id: iostream_usart
      instance:
        - vcom

  configuration:
    sl_iostream_usart_vcom_baudrate: 115200
    sl_iostream_usart_vcom_flow_control_type: usartHwFlowControlNone
    sl_iostream_usart_vcom_rx_port: gpioPortA
    sl_iostream_usart_vcom_rx_pin: 6
    sl_iostream_usart_vcom_tx_port: gpioPortA
    sl_iostream_usart_vcom_tx_pin: 5
